{
  "manifest_version": 3,
  "name": "WebDrop 快速傳送",
  "version": "1.0.0",
  "description": "右鍵傳送圖片/連結/文字到 WebDrop，或拖曳檔案快速傳送到已連線的房間。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "tabs", "notifications", "scripting"],
  "host_permissions": ["https://webdrop-6l1u.onrender.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://webdrop-6l1u.onrender.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://webdrop-6l1u.onrender.com/*"],
      "js": ["content.js"],
      "css": ["dropzone.css"],
      "run_at": "document_idle"
    }
  ]
}
